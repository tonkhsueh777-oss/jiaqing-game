{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "嘉庆君游台湾：御前争霸",
  "version": "1.0.1",
  "identifier": "com.redseed.jiaqinggame",
  "build": {
    "beforeBuildCommand": "npm run desktop:stage",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "嘉庆君游台湾：御前争霸",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"]
  }
}
